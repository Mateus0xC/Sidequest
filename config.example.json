{
  // Pasta com os .json de questões (somente leitura) e arquivo de progresso.
  "pasta_questoes": "D:/Arquivos/Downloads/sbd2/questoes",
  "estado": "estado.json",

  // Janela cuja miniatura aparece no canto. Para testar, use "Bloco de Notas" e deixe a classe vazia.
  "janela_alvo": { "titulo": "VALORANT", "classe": "VALORANTUnrealWindow" },

  // modo: "fundo" = jogo ao vivo borrado e escuro atrás da pergunta; "canto" = miniatura no canto
  "previa": { "ativa": true, "modo": "fundo", "largura_pct": 22, "canto": "bottom-right", "margem": 24 },

  // tela_cheia | canto | desligado   (segundo_monitor chega na Etapa 3)
  "exibicao": { "morte": "tela_cheia", "compra": "canto", "canto_compra": "top-right" },

  "tempos": { "espera_morte_ms": 1500, "espiar_s": 4, "fase_compra_s": 20, "pilula_s": 12, "intervalo_minimo_s": 0 },

  // 0.15 = abaixa o Valorant para 15% do volume atual enquanto estou morto (depois da espera); 1.0 desliga
  "volume_na_morte": 0.15,

  "estudo": { "voltar_apos_cartoes": 3, "limite_erros_conteudo": 3, "caixas_dias": [0, 1, 3, 7, 14, 30] },

  "teclas": { "morri": "F1", "revivi": "F2", "round_comecou": "F3", "fim_de_partida": "F4", "espiar": "F5", "agora_nao": "F6" }
}
